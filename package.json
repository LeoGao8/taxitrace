{
  "name": "taxi-trace",
  "version": "0.1.0",
  "private": true,
  "description": "Highlight ATC taxi clearances on an airport chart (OSM or your own traced chart).",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.js",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "wrangler": "^4.131.2"
  }
}
