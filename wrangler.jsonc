{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxitrace",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-15",
  // Runs before every deploy/dev, so a git-integration build needs no extra setup:
  // it bakes public/ plus the committed data/airports/ into dist/.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker, so the SPA fallback can never answer an API call with index.html.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
