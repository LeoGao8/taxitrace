{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxitrace",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker, so the SPA fallback can never answer an API call with index.html.
    "run_worker_first": ["/api/*"]
  },
  // Airport data (meta, OSM cache, traces, chart images) under airports/<ICAO>/.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "taxitrace-data" }],
  "observability": { "enabled": true }
}
